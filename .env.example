# Copy to .env and fill real values. Never commit .env.

# App
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8080
DEFAULT_USER_ID=1

# LLM (DashScope OpenAI-compatible)
API_KEY=
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CODER_MODEL=qwen3-coder-plus

# MySQL (same schema as rasa_ecs_0319)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecs
DB_USER=root
DB_PASSWORD=

# Neo4j
NEO4J_URL=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Embeddings (OpenAI-compatible, e.g. local BGE FastAPI)
EMBED_BASE_URL=http://127.0.0.1:10010/v1
EMBED_MODEL=bge-base-zh-v1.5
EMBED_API_KEY=EMPTY

# Checkpoint: memory | sqlite | postgres
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_SQLITE_PATH=.checkpoints/langgraph.db
CHECKPOINT_POSTGRES_URI=

# Knowledge
KNOWLEDGE_ENABLED=true
KNOWLEDGE_TOP_K=10
